# ════════════════════════════════════════════════════════════════════════
# Titecx Forge — .gitignore
# ════════════════════════════════════════════════════════════════════════

# ── dependencies ───────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── environment / secrets — NEVER commit these ──────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.pem
*.key
supabase/.env
supabase/.temp

# ── testing ───────────────────────────────────────────────────────────
/coverage

# ── next.js ───────────────────────────────────────────────────────────
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# ── production ───────────────────────────────────────────────────────
/build

# ── misc OS files ────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── debug logs ────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── vercel ────────────────────────────────────────────────────────────
.vercel

# ── editor ────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea

# ── large client-side runtime assets fetched at build/runtime,
#    not meant to be vendored into the repo ──────────────────────────
/public/wasm-cache/
/public/pyodide-cache/
