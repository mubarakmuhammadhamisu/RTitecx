# ════════════════════════════════════════════════════════════════════════
# Titecx Forge — environment variables
# ────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is already in .gitignore.
# See docs/SETUP.md for step-by-step instructions on obtaining each value.
# ════════════════════════════════════════════════════════════════════════

# ── Supabase ────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-side ONLY, never exposed to the browser.
# Used in admin API routes that must bypass RLS (e.g. bulk admin actions).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Paystack ────────────────────────────────────────────────────────────
# Found in: Paystack Dashboard → Settings → API Keys & Webhooks
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must match the URL configured as the webhook endpoint in the Paystack
# dashboard exactly, e.g. https://yourdomain.com/api/paystack/webhook
PAYSTACK_WEBHOOK_URL=https://yourdomain.com/api/paystack/webhook

# ── Video Providers ─────────────────────────────────────────────────────
# Only required if the admin enables that provider's library/account in
# /admin/video-providers. YouTube and Google Drive require no API keys
# for basic embed playback.

# Bunny Stream — per-library Stream API key (video.bunnycdn.com)
BUNNY_STREAM_API_KEY=
# Bunny account-level API key (api.bunny.net) — for library settings only
BUNNY_ACCOUNT_API_KEY=

# Gumlet
GUMLET_API_KEY=
GUMLET_WORKSPACE_ID=

# ── Interactive Code Engine ─────────────────────────────────────────────
# CheerpJ (Java-in-browser) loader script version/URL — see docs/SETUP.md
NEXT_PUBLIC_CHEERPJ_VERSION=4.1
# Pyodide and Emscripten/clang-wasm assets are loaded from their public
# CDNs by default (no key required); override only for self-hosted builds.
NEXT_PUBLIC_PYODIDE_CDN_URL=https://cdn.jsdelivr.net/pyodide/v0.27.0/full/
NEXT_PUBLIC_WASM_CLANG_CDN_URL=

# ── App ─────────────────────────────────────────────────────────────────
# The deployed URL — MUST be set correctly for OpenGraph/Twitter Card
# previews (e.g. WhatsApp link previews) to render images properly.
NEXT_PUBLIC_SITE_URL=https://your-deployed-domain.com
